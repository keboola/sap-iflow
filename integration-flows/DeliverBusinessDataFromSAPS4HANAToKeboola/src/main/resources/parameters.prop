#Externalized parameters - configure per tenant
S4_HOSTNAME=
S4_AUTH_METHOD=OAuth2 Client Credentials
S4_CREDENTIAL_ALIAS=KEBOOLA_S4
S4_PRIVATE_KEY_ALIAS=
HTTP_TIMEOUT_MS=120000
S4_PROXY_TYPE=default
S4_CC_LOCATION_ID=
AIR_KEY=
AIR_HEADER_NAME=
S4_SAP_CLIENT=
SERVICE_PATH=/sap/opu/odata/sap/API_BUSINESS_PARTNER
ENTITY_SET=A_BusinessPartner
ODATA_SELECT=
ODATA_FILTER=
LOAD_MODE=full
DELTA_FIELD=LastChangeDate,CreationDate
DELTA_FIELD_TYPE=datetime
DELTA_PRECISION=day
DELTA_OVERLAP_MINUTES=15
PAGE_SIZE=5000
DELIVERY_SCHEDULE=<row><cell>dateType</cell><cell>ADVANCED</cell></row><row><cell>hourValue</cell><cell></cell></row><row><cell>minutesValue</cell><cell></cell></row><row><cell>timeType</cell><cell>ON_TIME</cell></row><row><cell>timeZone</cell><cell>( UTC 0\:00 ) Greenwich Mean Time(Etc/GMT)</cell></row><row><cell>throwExceptionOnExpiry</cell><cell>false</cell></row><row><cell>second</cell><cell>0</cell></row><row><cell>minute</cell><cell>0</cell></row><row><cell>hour</cell><cell>2</cell></row><row><cell>day_of_month</cell><cell>?</cell></row><row><cell>month</cell><cell>*</cell></row><row><cell>dayOfWeek</cell><cell>*</cell></row><row><cell>year</cell><cell>*</cell></row><row><cell>startAt</cell><cell></cell></row><row><cell>endAt</cell><cell></cell></row><row><cell>attributeBehaviour</cell><cell>isThrowExceptionOnExpiryVisible,isScheduleAdvancedVisible,isScheduleAdvancedStartEndVisible,isScheduleSimpleVisible</cell></row><row><cell>triggerType</cell><cell>cron</cell></row><row><cell>noOfSchedules</cell><cell>1</cell></row><row><cell>schedule1</cell><cell>0+0+2+?+*+*+*&amp;trigger.timeZone\=Etc/GMT</cell></row>
DELIVERY_ADDRESS=/keboola/deliver
SENDER_ROLE=ESBMessaging.send
DELIVERY_QUEUE_NAME=KeboolaDelivery
DELIVERY_RETRY_INTERVAL_MIN=3
DELIVERY_MAX_RETRY_INTERVAL_MIN=60
KEBOOLA_STACK_URL=
KEBOOLA_TABLE_ID=
KEBOOLA_CREDENTIAL_ALIAS=KEBOOLA_STORAGE
KEBOOLA_IMPORTER_URL=
PRIMARY_KEY=BusinessPartner
